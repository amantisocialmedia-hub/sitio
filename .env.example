# ====== AMANTI STORE — variables de entorno ======
# Copia este archivo como ".env" y rellena los valores.

# Numero de WhatsApp para pedidos (formato: 52 + 1 + numero, sin + ni espacios)
# OBLIGATORIA: el valor de abajo es un PLACEHOLDER ficticio — cambialo por el numero real
# antes de publicar o los enlaces de WhatsApp iran a un numero inexistente.
NUXT_PUBLIC_WHATSAPP_PHONE=5214430000000

# Token de MercadoPago (sandbox para pruebas, produccion para vender de verdad)
# Lo sacas en: https://www.mercadopago.com.mx/developers -> Tus integraciones
NUXT_MP_ACCESS_TOKEN=

# Secreto del webhook de MercadoPago (panel MP -> Webhooks -> secreto). Valida la firma HMAC
# de las notificaciones de pago. Recomendado en prod.
NUXT_MP_WEBHOOK_SECRET=

# ====== Stripe (pagos con tarjeta) ======
# Llave SECRETA de Stripe (Stripe -> Developers -> API keys). sk_test_... para pruebas, sk_live_... para real.
# SOLO server-side, NUNCA con prefijo publico. Sin ella, /api/stripe-checkout devuelve 400.
NUXT_STRIPE_SECRET_KEY=

# Secreto de firma del webhook de Stripe (Stripe -> Developers -> Webhooks -> tu endpoint -> Signing secret).
# Empieza con whsec_... Valida la firma de las notificaciones. OBLIGATORIO para /api/stripe-webhook.
NUXT_STRIPE_WEBHOOK_SECRET=

# Pon "1" para MOSTRAR el boton "Pagar con tarjeta" (Stripe) en el carrito. Vacio = oculto.
NUXT_PUBLIC_STRIPE_ENABLED=

# URL publica del sitio (para los redirects de MercadoPago)
# En local dejalo en http://localhost:3000 ; en produccion: https://amanti.mx
NUXT_PUBLIC_PUBLIC_BASE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=https://amanti.mx

# Supabase (cuentas de usuario). SUPABASE_KEY = anon/public (eyJ...).
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_KEY=eyJ...

# Service role / secret key de Supabase — SOLO server-side, NUNCA con prefijo publico.
# OBLIGATORIA en prod: la usan checkout, el webhook MP y la creacion de orders. Sin ella
# TODO pago con MercadoPago devuelve HTTP 500. Supabase -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel: una URL de Inbound Webhook POR automatizacion.
# GHL no da un webhook global: genera una URL distinta por workflow.
# VACIO O AUSENTE = ese evento queda apagado; el resto sigue funcionando.
#
# OJO: estos triggers son PREMIUM y GHL los cobra POR USO. No los pongas en
# entornos de prueba que disparen trafico real, y no compartas las URLs:
# quien las tenga puede disparar el workflow y generar cobro.
NUXT_GHL_WEBHOOK_POSTCOMPRA=
NUXT_GHL_WEBHOOK_CARRITO_ABANDONADO=
NUXT_GHL_WEBHOOK_REACTIVACION=
# Aviso a QUIEN SURTE (Nancy) de que entro un pedido que hay que preparar.
NUXT_GHL_WEBHOOK_AVISO_PEDIDO=
# Aviso al CLIENTE de que su pedido ya salio, con el numero de guia.
NUXT_GHL_WEBHOOK_PEDIDO_ENVIADO=
